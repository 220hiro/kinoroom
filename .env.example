# ========================================================
# KINOROOM CONFIGURATION TEMPLATE
# ========================================================

# Your Domain or IP address for Caddy automatic HTTPS
# Example: DOMAIN=kinoroom.kz
# Or if using without domain: DOMAIN=:80
DOMAIN=localhost

# TMDB API Key for movie posters, casts, and metadata catalog
# Free to obtain at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Internal TorrServer URL (used by Next.js backend for torrent streaming)
TORRSERVER_URL=http://torrserver:8090

# Next.js Authentication secret (generate any random string)
AUTH_SECRET=changeme_kinoroom_secure_random_key_12345

# ========================================================
# AUTOMATED SUBTITLE PROVIDERS (Step 2F)
# ========================================================

# SubDL API v2 Key (Primary source for Russian subtitles)
# Documentation: https://subdl.com/developers
SUBDL_API_KEY=

# OpenSubtitles REST API v1 (Fallback source for Russian subtitles)
# Documentation: https://opensubtitles.tawk.help/article/getting-started
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
