# Configure on an EXTERNAL server. No tunnel or laptop daemon is required.
DOMAIN=cinema.example.com
TMDB_API_KEY=
# Required for a publicly reachable deployment.
SITE_PASSWORD=
AUTH_SECRET=
# Enable media workers only in the external deployment, not on Vercel or the laptop.
KADR_MEDIA_ENABLED=0
KADR_MAX_STREAMS=4
TORRSERVER_URL=
TORRSERVER_AUTH=
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
JACKETT_URL=
JACKETT_API_KEY=
JACKETT_INDEXERS=noname-club
SUBDL_API_KEY=
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
